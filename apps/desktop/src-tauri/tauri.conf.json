{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rampart",
  "version": "0.1.0",
  "identifier": "dev.rampart.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web -- --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "pnpm build:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rampart",
        "width": 1360,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
